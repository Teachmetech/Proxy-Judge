{
  "name": "proxy-judge-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "Proxy Judge — frontend and backend",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm --filter proxy-judge-frontend dev\" \"pnpm --filter proxy-judge-backend dev\"",
    "dev:frontend": "pnpm --filter proxy-judge-frontend dev",
    "dev:backend": "pnpm --filter proxy-judge-backend dev",
    "build": "pnpm --filter proxy-judge-frontend build",
    "start:backend": "pnpm --filter proxy-judge-backend start",
    "test:backend": "pnpm --filter proxy-judge-backend test",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.12.2"
}
