# Copy to .env at the repo root before `docker compose up`
#   cp .env.example .env

NODE_ENV=production
PORT=8000

# Hop count for Express trust proxy (nginx = 1)
TRUST_PROXY=1

# Comma-separated origins, or * for public API
CORS_ORIGINS=*

# Timeouts (ms)
GEO_TIMEOUT_MS=5000
BLACKLIST_TIMEOUT_MS=2500
