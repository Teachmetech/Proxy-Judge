# Copy to .env at the repo root before `docker compose up`
#   cp .env.example .env

NODE_ENV=production
PORT=8000

# Hop count for Express trust proxy (nginx = 1)
TRUST_PROXY=1

# Comma-separated origins, or * for public API
CORS_ORIGINS=*

# Timeouts (ms)
GEO_TIMEOUT_MS=5000
BLACKLIST_TIMEOUT_MS=750

# Optional: authenticated Spamhaus DQS access (never commit a real key)
SPAMHAUS_DQS_KEY=

# Cache stable IP metadata so repeat checks do not wait on external services
GEO_CACHE_TTL_MS=3600000
BLACKLIST_CACHE_TTL_MS=600000
